
#
# Mnemonic Maps
#
mmap new -reuse -name {Boolean as Logic} -radix %b -contents {{%c=FALSE -edgepriority 1 -shape low}
{%c=TRUE -edgepriority 1 -shape high}}
mmap new -reuse -name {Example Map} -radix %x -contents {{%b=11???? -bgcolor orange -label REG:%x -linecolor yellow -shape bus}
{%x=1F -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=2C -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=* -label %x -linecolor gray -shape bus}}

array unset createdGroup
array set createdGroup {}
set id [waveform add -signals [subst  {
	{[format {tb_axi_master_wrapper.uut.clk}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb_axi_master_wrapper.uut.rst_n}]}
	} ]]
set id [waveform add -cdivider divider]
set id [waveform add -signals [subst  {
	{[format {tb_axi_master_wrapper.uut.present_state[2:0]}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb_axi_master_wrapper.uut.next_state[2:0]}]}
	} ]]
set id [waveform add -cdivider divider]
set id [waveform add -signals [subst  {
	{[format {tb_axi_master_wrapper.uut.in_address[31:0]}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb_axi_master_wrapper.uut.in_valid}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb_axi_master_wrapper.uut.write_en}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb_axi_master_wrapper.uut.read_en}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb_axi_master_wrapper.uut.write_data[31:0]}]}
	} ]]
set id [waveform add -cdivider divider]
set id [waveform add -signals [subst  {
	{[format {tb_axi_master_wrapper.uut.M_AXI_AWADDR[31:0]}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb_axi_master_wrapper.uut.M_AXI_AWVALID}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb_axi_master_wrapper.uut.M_AXI_AWREADY}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb_axi_master_wrapper.uut.aw_done}]}
	} ]]
set id [waveform add -cdivider divider]
set id [waveform add -signals [subst  {
	{[format {tb_axi_master_wrapper.uut.M_AXI_WDATA[31:0]}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb_axi_master_wrapper.uut.M_AXI_WVALID}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb_axi_master_wrapper.uut.M_AXI_WREADY}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb_axi_master_wrapper.uut.w_done}]}
	} ]]
set id [waveform add -cdivider divider]
set id [waveform add -signals [subst  {
	{[format {tb_axi_master_wrapper.uut.M_AXI_BVALID}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb_axi_master_wrapper.uut.M_AXI_BREADY}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb_axi_master_wrapper.uut.M_AXI_BRESP[1:0]}]}
	} ]]
set id [waveform add -cdivider divider]
set id [waveform add -signals [subst  {
	{[format {tb_axi_master_wrapper.uut.M_AXI_ARADDR[31:0]}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb_axi_master_wrapper.uut.M_AXI_ARVALID}]}
	} ]]
