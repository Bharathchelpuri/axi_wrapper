
#
# Mnemonic Maps
#
mmap new -reuse -name {Boolean as Logic} -radix %b -contents {{%c=FALSE -edgepriority 1 -shape low}
{%c=TRUE -edgepriority 1 -shape high}}
mmap new -reuse -name {Example Map} -radix %x -contents {{%b=11???? -bgcolor orange -label REG:%x -linecolor yellow -shape bus}
{%x=1F -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=2C -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=* -label %x -linecolor gray -shape bus}}

array unset createdGroup
array set createdGroup {}
set id [waveform add -signals [subst  {
	{[format {tb_axi_master_wrapper.DUT.next_state[2:0]}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb_axi_master_wrapper.DUT.present_state[2:0]}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb_axi_master_wrapper.DUT.in_valid}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb_axi_master_wrapper.DUT.write_en}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb_axi_master_wrapper.DUT.read_en}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb_axi_master_wrapper.DUT.illegal_addr}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb_axi_master_wrapper.DUT.bg_axi_awaddr[31:0]}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb_axi_master_wrapper.DUT.bg_axi_awvalid}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb_axi_master_wrapper.DUT.bg_axi_awready}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb_axi_master_wrapper.DUT.aw_done}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb_axi_master_wrapper.DUT.bg_axi_wvalid}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb_axi_master_wrapper.DUT.bg_axi_wready}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb_axi_master_wrapper.DUT.w_done}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb_axi_master_wrapper.DUT.bridge_sel}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb_axi_master_wrapper.DUT.mem_sel}]}
	} ]]

waveform xview limits 0 700ns
